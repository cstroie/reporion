<?php
declare(strict_types=1);

// conf/local.php — copy from this file and edit. NEVER committed (see .gitignore).
//
// Only what the application needs before it can find data/ (paths) and
// secrets (the session key) belong here. This instance's settings — site
// name, tagline, public address, home page, time zone, icon, sites and
// devices, feeds, export switches, limits — are edited in Admin → Settings
// and kept in data/settings.yaml (docs/FORMATS.md). The same keys below are
// only fallbacks until a section is saved there; a fresh install needs
// site.home_page and pages.trash_purge_days.

return [
    // Fallbacks — Admin → Settings → Site
    'site' => [
        'title'        => 'Reporion',
        'tagline'      => 'Imaging reports',
        'base_url'     => 'https://reports.example.ro',
        'timezone'     => 'Europe/Bucharest',
        'locale'       => 'ro_RO',      // content locale; UI strings are English (D26)
        'home_page'    => 'site:home',  // rendered at / for anonymous visitors (D16)
        'theme'        => 'dark',       // dark | light | os
    ],

    'auth' => [
        // Accounts live in data/users/*.json now (D35), not here. Create
        // the first owner account with:
        //   bin/reporion user:create --username=<u> --password-hash=<h> --owner
        // bin/reporion doctor prints a ready-made hash for --password-hash:
        //   php -r 'echo password_hash("…", PASSWORD_ARGON2ID);'
        // HMAC key for the signed session cookie (D35). Generate one with:
        //   php -r 'echo bin2hex(random_bytes(32));'
        'session_secret'      => '',
        'session_name'        => 'reporion',
        'session_lifetime'    => 60 * 60 * 24 * 30,
        'idle_reauth'         => 0,      // seconds; 0 = never
    ],

    'paths' => [
        // all OUTSIDE the document root (D23)
        'data'   => dirname(__DIR__) . '/data',
        'media'  => dirname(__DIR__) . '/data/media',
        'index'  => dirname(__DIR__) . '/data/index.sqlite',
        'audit'  => dirname(__DIR__) . '/data/audit',
        'trash'  => dirname(__DIR__) . '/data/trash',
        'import' => dirname(__DIR__) . '/data/import',
    ],

    // trash_purge_days: fallback — Admin → Settings → Limits
    'pages' => [
        'path_pattern'       => 'reports:{modality}:{site}:{yymmdd}-{name}', // D1
        'default_visibility' => 'private',
        'trash_purge_days'   => 30,
        'lock_minutes'       => 15,       // advisory only, never blocking
        'autosave_seconds'   => 10,
    ],

    'accession' => [
        'generate' => true,               // D20
        'pattern'  => '{SITE}-{MOD}-{yy}-{seq}',
        'seq_pad'  => 4,
    ],

    // Fallback — Admin → Settings → Sites and devices
    'sites' => [
        // code => printed letterhead (name, dept, address, phone) + devices
        'mioveni' => [
            'name'    => 'Spital Orasenesc Mioveni',
            'dept'    => 'Radiologie si imagistica medicala',
            'devices' => ['MV-MR-01' => 'Siemens Aera 1.5 T', 'MV-CT-01' => 'Siemens Emotion 16'],
        ],
    ],

    'signature' => [
        'display_name' => 'Dr. …',
        'title'        => 'Medic primar radiologie si imagistica medicala',
        'parafa'       => '',
        'image'        => '',             // conf/signature.png, optional
    ],

    'search' => [
        'weight_bm25'    => 0.6,          // hybrid ranking; vector half is 1 - this
        'weight_vector'  => 0.4,
        'public_search'  => true,         // anonymous search over public pages only
        'synonyms_file'  => dirname(__DIR__) . '/conf/synonyms.txt', // D28
        'prefix_last_token' => true,
    ],

    // Fallback — Admin → Settings → Publishing and export
    'feeds' => [
        // Atom feeds (/feed.atom, /feed/{ns}.atom) for these namespaces only:
        // public pages without patient data. Empty = no feeds. "reports"
        // and anything under it is never a feed, even if listed here.
        'namespaces' => [],          // e.g. ['docs', 'teaching']
    ],

    // Fallback — Admin → Settings → Limits
    'media' => [
        'max_bytes' => 8 * 1024 * 1024,   // pasted/dropped images; PHP post_max_size must allow it
    ],
    // allow_*/pseudonymise_public: fallbacks — Admin → Settings → Publishing and export
    'export' => [
        'engine_pdf'          => 'dompdf', // D34 — table-based print CSS only
        'allow_draft_export'  => false,
        'allow_public_export' => true,
        'pseudonymise_public' => true,
        'embed_rev_and_qr'    => true,     // D3: exports cite /r/{pid}/{rev}
    ],

    'ai' => [
        'provider'        => null,          // D15 — nothing enabled by default
        'endpoint'        => '',
        'model'           => '',
        'strip_patient'   => true,          // enforced in code regardless
        'allow_egress_to' => [],            // empty = no outbound HTTP at all
    ],

    'index' => [
        'schema_version' => 1,
        'vectors'        => false,          // needs a loadable sqlite extension
        'verify_cron'    => '03:30',
    ],

    'plugins' => [
        'enabled' => ['export-pdf-letterhead', 'search-synonyms'],
    ],
];
