<?php
declare(strict_types=1);

// conf/local.php: copy from this file and edit. NEVER committed (see .gitignore).
//
// Strict configuration only: where data/ is, and the secret that signs the
// session cookie. Everything else: site name, tagline, public address,
// time zone, home page, sites and devices, feeds, export switches, limits,
// plugins, the AI servers and their keys: is edited in the admin screens
// and kept in data/settings.yaml (docs/FORMATS.md §3d), with the data it
// describes. The built-in defaults are in Kernel::DEFAULTS.

return [
    'auth' => [
        // Accounts live in data/users/*.json (D35), not here. Create the
        // first owner account with:
        //   bin/reporion user:create --username=<u> --password-hash=<h> --owner
        // bin/reporion doctor prints a ready-made hash for --password-hash:
        //   php -r 'echo password_hash("…", PASSWORD_ARGON2ID);'
        // HMAC key for the signed session cookie. Generate one with:
        //   php -r 'echo bin2hex(random_bytes(32));'
        // Left empty, nobody can sign in: a cookie signed with an empty key
        // is one anyone could forge, so none is issued or accepted.
        'session_secret' => '',
    ],

    'paths' => [
        // OUTSIDE the document root (D23). The databases (data/reporion.sqlite,
        // index.sqlite, vectors.sqlite) and the audit log (data/audit/) are found inside it.
        'data' => dirname(__DIR__) . '/data',
    ],
];
