{
  "name": "reporion/reporion",
  "description": "Flat-file wiki for professional imaging reports. Markdown on disk, SQLite index, server-rendered documents with JS islands.",
  "type": "project",
  "license": "GPL-3.0-or-later",
  "require": {
    "php": ">=8.1",
    "ext-pdo_sqlite": "*",
    "ext-sqlite3": "*",
    "ext-mbstring": "*",
    "ext-intl": "*",
    "ext-zlib": "*",
    "ext-dom": "*",
    "ext-ffi": "*",
    "ext-gd": "*",
    "ext-iconv": "*",
    "ext-xml": "*",
    "league/commonmark": "^2.4",
    "symfony/yaml": "^6.4",
    "dompdf/dompdf": "^3.0",
    "phpoffice/phpword": "^1.3"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5",
    "friendsofphp/php-cs-fixer": "^3.49",
    "phpstan/phpstan": "^1.10"
  },
  "autoload": {
    "psr-4": {
      "Reporion\\": "src/"
    },
    "files": [
      "src/lang.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Reporion\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "stan": "phpstan analyse src tests --level=6",
    "fix": "php-cs-fixer fix",
    "serve": [
      "Composer\\Config::disableProcessTimeout",
      "bin/reporion serve"
    ]
  },
  "config": {
    "sort-packages": true,
    "platform": {
      "ext-zip": "1.0.0"
    }
  }
}
